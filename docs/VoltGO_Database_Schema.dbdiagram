// VoltGO Database Schema
// Verified from 46 JPA Entities - Jun 2026
// PostgreSQL 16 + PostGIS 3.4 + Redis 7 + MinIO
// https://dbdiagram.io/d/VoltGO
// ============================================================
// GROUP 1: User / Authentication
// ============================================================

Table user_account {
  id uuid [pk, type: 'UUID']
  email varchar(255) [unique, not null]
  name varchar(255) [not null]
  phone varchar(20)
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
  status varchar(20) [not null]
  created_at timestamptz [not null]
  // Note: updated_at, last_login_at exist in doc but NOT in entity code
}

Table push_token {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  token text [not null]
  device_type varchar(20) [not null]
  is_active boolean [not null, default: true]
  last_used_at timestamptz
  created_at timestamptz [not null]
}

Table notification_preference {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  category varchar(50) [not null]
  push_enabled boolean [not null, default: true]
  email_enabled boolean [not null, default: true]
  in_app_enabled boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz
}

// ============================================================
// GROUP 2: Collaborator
// ============================================================

Table collaborator_profile {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_account_id uuid [unique, not null, ref: > user_account.id]
  full_name varchar(255)
  phone varchar(20)
  current_location geography(Point, 4326)
  location_updated_at timestamptz
  location_source varchar(20)
  created_at timestamptz [not null]
}

Table contract {
  id uuid [pk, default: 'uuid_generate_v4()']
  collaborator_id uuid [not null, ref: > collaborator_profile.id]
  region varchar(100)
  start_date date [not null]
  end_date date [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null]
  terminated_at timestamptz
  note text
}

Table collaborator_registration_request {
  id uuid [pk]
  email varchar(255) [not null]
  full_name varchar(255) [not null]
  phone varchar(20)
  date_of_birth date
  address text
  id_card_number varchar(20)
  bank_account_number varchar(50)
  bank_name varchar(100)
  contract_agreed_at timestamptz
  status varchar(20) [not null]
  rejection_reason text
  submission_count int [not null, default: 1]
  reviewed_by uuid [ref: > user_account.id]
  reviewed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// ============================================================
// GROUP 3: Station / Charging
// ============================================================

Table station {
  id uuid [pk, type: 'UUID']
  provider_id uuid [not null, ref: > user_account.id]
  created_at timestamptz [not null]
  // Note: updated_at exists in doc but NOT in entity code
}

Table station_version {
  id uuid [pk, type: 'UUID']
  station_id uuid [not null, ref: > station.id]
  version_no int [not null]
  workflow_status varchar(20) [not null]
  name varchar(255) [not null]
  address varchar(500) [not null]
  location geography(Point, 4326) [not null]
  operating_hours varchar(100)
  parking varchar(20) [not null]
  visibility varchar(20) [not null]
  public_status varchar(20) [not null]
  created_by uuid [not null, ref: > user_account.id]
  created_at timestamptz [not null]
  published_at timestamptz
  // Spatial GIST index on location defined at DB level
}

Table station_service {
  id uuid [pk, type: 'UUID']
  station_version_id uuid [not null, ref: > station_version.id]
  service_type varchar(20) [not null]
  total_batteries int
  avg_charge_power_kw decimal(6,2)
}

Table charging_port {
  id uuid [pk, type: 'UUID']
  station_service_id uuid [not null, ref: > station_service.id]
  power_type varchar(20) [not null]
  power_kw decimal(10,2) [not null]
  port_count int [not null]
}

Table charger_unit {
  id uuid [pk, default: 'uuid_generate_v4()']
  station_id uuid [not null, ref: > station.id]
  station_version_id uuid [not null, ref: > station_version.id]
  power_type varchar(20) [not null]
  power_kw decimal(10,2) [not null]
  label varchar(100) [not null]
  price_per_slot int [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null]
  // ChargerUnitStatus enum: ACTIVE, INACTIVE, MAINTENANCE
}

// ============================================================
// GROUP 4: Booking / Payment
// ============================================================

Table booking {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  station_id uuid [not null, ref: > station.id]
  charger_unit_id uuid [not null, ref: > charger_unit.id]
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  status varchar(20) [not null, default: 'HOLD']
  hold_expires_at timestamptz [not null]
  price_snapshot jsonb [not null, default: "'{}'"]
  voucher_redemption_id uuid [ref: > voucher_redemption.id]
  created_at timestamptz [not null]
  // Exclusion constraint: CK_BOOKING_NO_OVERLAP_ACTIVE
}

Table payment_intent {
  id uuid [pk, default: 'uuid_generate_v4()']
  booking_id uuid [unique, not null, ref: > booking.id]
  amount int [not null]
  currency varchar(3) [not null, default: 'VND']
  status varchar(20) [not null, default: 'CREATED']
  voucher_redemption_id uuid [ref: > voucher_redemption.id]
  discount_amount int
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// ============================================================
// GROUP 5: Battery Swap (Runtime State)
// ============================================================

Table battery_swap_station_state {
  station_id uuid [pk, ref: > station.id]
  total_batteries int [not null, default: 20]
  available_batteries int [not null, default: 10]
  avg_charge_power_kw decimal(6,2) [not null, default: 35.0]
  updated_at timestamptz [not null]
}

Table swap_pile {
  id uuid [pk, default: 'uuid_generate_v4()']
  station_id uuid [not null, ref: > station.id]
  pile_index int [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  // Unique: (station_id, pile_index)
}

Table battery_slot {
  id uuid [pk, default: 'uuid_generate_v4()']
  pile_id uuid [not null, ref: > swap_pile.id]
  slot_index int [not null]
  battery_id uuid
  battery_serial_number varchar(100)
  battery_capacity_kwh decimal(6,2) [not null, default: 60.0]
  battery_charge_percent int [not null, default: 100]
  status varchar(20) [not null, default: 'AVAILABLE']
  charging_started_at timestamptz
  estimated_full_at timestamptz
  updated_at timestamptz [not null]
  // Unique: (pile_id, slot_index)
}

Table battery_swap_reservation {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  station_id uuid [not null, ref: > station.id]
  pile_id uuid [ref: > swap_pile.id]
  slot_id uuid [ref: > battery_slot.id]
  status varchar(20) [not null, default: 'RESERVED']
  reserved_slot_at timestamptz
  requested_battery_percent int [not null, default: 20]
  battery_capacity_kwh decimal(6,2) [not null, default: 60.0]
  estimated_ready_at timestamptz
  note text
  reserved_at timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  confirmed_arrival_at timestamptz
  swap_code varchar(10)
  swap_deadline_at timestamptz
  base_price_vnd bigint [not null, default: 5000]
  payment_status varchar(20) [not null, default: 'UNPAID']
  updated_at timestamptz [not null]
  // BatterySwapStatus: RESERVED, CONFIRMED, SWAPPING, COMPLETED, CANCELLED, EXPIRED
  // PaymentStatus: UNPAID, PAID, REFUNDED
}

Table swap_payment {
  id uuid [pk, default: 'uuid_generate_v4()']
  reservation_id uuid [not null, ref: > battery_swap_reservation.id]
  amount_vnd bigint [not null]
  status varchar(20) [not null, default: 'PENDING']
  created_at timestamptz [not null]
  paid_at timestamptz
  refunded_at timestamptz
  expired_at timestamptz
  // SwapPaymentStatus: PENDING, PAID, REFUNDED, FAILED
}

Table swap_session {
  id uuid [pk, default: 'uuid_generate_v4()']
  reservation_id uuid [not null, ref: > battery_swap_reservation.id]
  swap_code varchar(10) [unique, not null]
  status varchar(20) [not null, default: 'PENDING']
  expires_at timestamptz [not null]
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null]
  created_by uuid [ref: > user_account.id]
  completed_by uuid [ref: > user_account.id]
  // SwapSessionStatus: PENDING, ACTIVE, COMPLETED, EXPIRED
}

Table charging_session {
  id uuid [pk, default: 'uuid_generate_v4()']
  battery_slot_id uuid [not null, ref: > battery_slot.id]
  start_percent int [not null, default: 0]
  end_percent int
  start_kwh decimal(8,4)
  end_kwh decimal(8,4)
  status varchar(20) [not null, default: 'CHARGING']
  started_at timestamptz [not null]
  estimated_full_at timestamptz
  completed_at timestamptz
  // ChargingSessionStatus: CHARGING, COMPLETED, INTERRUPTED
}

Table battery_event {
  id uuid [pk, default: 'uuid_generate_v4()']
  battery_slot_id uuid [not null, ref: > battery_slot.id]
  event_type varchar(20) [not null]
  old_state varchar(50)
  new_state varchar(50)
  old_percent int
  new_percent int
  metadata jsonb
  created_at timestamptz [not null]
  created_by uuid [ref: > user_account.id]
  actor_type varchar(20)
  // BatteryEventType: INSERTED, REMOVED, CHARGE_START, CHARGE_COMPLETE, RESERVED
}

// ============================================================
// GROUP 6: Battery Swap (Version / Template)
// ============================================================

Table battery_swap_station_version {
  id uuid [pk, default: 'uuid_generate_v4()']
  station_id uuid [not null, ref: > station.id]
  version_no int [not null, default: 1]
  workflow_status varchar(20) [not null, default: 'DRAFT']
  total_batteries int [not null]
  avg_charge_power_kw decimal(6,2) [not null]
  operating_hours varchar(100) [not null]
  parking_fee decimal(10,2)
  note text
  created_by uuid [not null, ref: > user_account.id]
  created_at timestamptz [not null]
  published_at timestamptz
  submitted_at timestamptz
}

Table battery_swap_pile_template {
  id uuid [pk, default: 'uuid_generate_v4()']
  station_version_id uuid [not null, ref: > battery_swap_station_version.id]
  pile_index int [not null]
  slots_per_pile int [not null, default: 6]
}

Table battery_swap_slot_template {
  id uuid [pk, default: 'uuid_generate_v4()']
  pile_template_id uuid [not null, ref: > battery_swap_pile_template.id]
  slot_index int [not null]
  battery_capacity_kwh decimal(6,2) [not null, default: 60.0]
}

Table battery_swap_station_device {
  station_id uuid [pk, ref: > station.id]
  device_key varchar(64) [unique, not null]
  device_name varchar(100)
  created_at timestamptz [not null]
  last_seen_at timestamptz
}

// ============================================================
// GROUP 7: Governance / Verification
// ============================================================

Table change_request {
  id uuid [pk, type: 'UUID']
  type varchar(20) [not null]
  status varchar(20) [not null]
  station_id uuid [ref: > station.id]
  proposed_station_version_id uuid [not null, ref: > station_version.id]
  submitted_by uuid [not null, ref: > user_account.id]
  risk_score int [not null, default: 0]
  risk_reasons jsonb [not null, default: "'[]'"]
  admin_note text
  created_at timestamptz [not null]
  submitted_at timestamptz
  decided_at timestamptz
  // ChangeRequestType: CREATE_STATION, UPDATE_STATION, DELETE_STATION
  // ChangeRequestStatus: DRAFT, SUBMITTED, PENDING, APPROVED, REJECTED, PUBLISHED
}

Table battery_swap_change_request {
  id uuid [pk, default: 'uuid_generate_v4()']
  type varchar(20) [not null]
  status varchar(20) [not null, default: 'DRAFT']
  station_id uuid [ref: > station.id]
  proposed_version_id uuid [not null, ref: > battery_swap_station_version.id]
  submitted_by uuid [not null, ref: > user_account.id]
  risk_score int [not null, default: 0]
  risk_reasons text [not null, default: '''[]''']
  admin_note text
  created_at timestamptz [not null]
  submitted_at timestamptz
  decided_at timestamptz
  // Note: risk_reasons is TEXT in code (not JSONB like change_request)
}

Table report_issue {
  id uuid [pk, default: 'uuid_generate_v4()']
  station_id uuid [not null, ref: > station.id]
  reporter_id uuid [not null, ref: > user_account.id]
  category varchar(50) [not null]
  description text [not null]
  status varchar(20) [not null, default: 'OPEN']
  created_at timestamptz [not null]
  decided_at timestamptz
  admin_note text
  // IssueCategory: WRONG_LOCATION, BROKEN_CHARGER, WRONG_INFO, OTHER
  // IssueStatus: OPEN, IN_PROGRESS, RESOLVED, CLOSED
}

Table verification_task {
  id uuid [pk, default: 'uuid_generate_v4()']
  station_id uuid [not null, ref: > station.id]
  change_request_id uuid [ref: > change_request.id]
  priority int [not null, default: 3]
  sla_due_at timestamptz
  assigned_to uuid [ref: > collaborator_profile.id]
  status varchar(20) [not null, default: 'OPEN']
  verification_type varchar(20) [not null, default: 'CHARGING_STATION']
  battery_swap_change_request_id uuid [ref: > battery_swap_change_request.id]
  battery_swap_station_snapshot jsonb
  checklist_json jsonb
  station_snapshot_json jsonb
  created_at timestamptz [not null]
  // VerificationTaskStatus: OPEN, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
  // VerificationType: CHARGING_STATION, BATTERY_SWAP_STATION
}

Table verification_checkin {
  id uuid [pk, default: 'uuid_generate_v4()']
  task_id uuid [unique, not null, ref: > verification_task.id]
  checkin_lat decimal(10,7) [not null]
  checkin_lng decimal(10,7) [not null]
  checked_in_at timestamptz [not null]
  distance_m int [not null]
  device_note text
  actual_total_batteries int
  actual_available_batteries int
  observed_avg_charge_power_kw decimal(6,2)
  checklist_answers_json jsonb
}

Table verification_evidence {
  id uuid [pk, default: 'uuid_generate_v4()']
  task_id uuid [not null, ref: > verification_task.id]
  photo_object_key text [not null]
  note text
  submitted_at timestamptz [not null]
  submitted_by uuid [not null, ref: > user_account.id]
}

Table verification_review {
  id uuid [pk, default: 'uuid_generate_v4()']
  task_id uuid [unique, not null, ref: > verification_task.id]
  result varchar(20) [not null]
  admin_note text
  reviewed_at timestamptz [not null]
  reviewed_by uuid [not null, ref: > user_account.id]
  swap_station_verified boolean
  inventory_accurate boolean
  resolution_note text
  // VerificationResult: VERIFIED, REJECTED, REQUIRES_RESUBMISSION
}

// ============================================================
// GROUP 8: Trust / Loyalty / Audit
// ============================================================

Table station_trust {
  station_id uuid [pk, ref: > station.id]
  score int [not null]
  breakdown jsonb [not null]
  updated_at timestamptz [not null]
}

Table battery_swap_trust {
  id uuid [pk, default: 'uuid_generate_v4()']
  station_id uuid [unique, not null, ref: > station.id]
  score int [not null, default: 50]
  breakdown jsonb [not null, default: "'{}'"]
  last_event_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table loyalty_user_profile {
  user_id uuid [pk, ref: > user_account.id]
  current_points int [not null, default: 0]
  lifetime_points int [not null, default: 0]
  total_ratings int [not null, default: 0]
  total_bookings int [not null, default: 0]
  total_swaps int [not null, default: 0]
  total_contributions int [not null, default: 0]
  last_activity_at timestamptz
  level int [not null, default: 1]
  updated_at timestamptz [not null]
}

Table loyalty_point_transaction {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  type varchar(20) [not null]
  source varchar(50) [not null]
  source_id uuid
  points int [not null]
  balance_after int [not null]
  description varchar
  metadata jsonb
  created_at timestamptz [not null]
  // PointType: EARN, REDEEM, ADJUSTMENT
  // PointSource: BOOKING_COMPLETE, REFERRAL_SIGNUP, REFERRAL_COMPLETE, RATING_BONUS, etc.
}

Table voucher_definition {
  id uuid [pk, type: 'UUID']
  code varchar(50) [unique, not null]
  name varchar(255) [not null]
  description text
  voucher_type varchar(20) [not null]
  point_cost int [not null]
  discount_percent int
  max_value_vnd int
  service_type varchar(20)
  status varchar(20) [not null, default: 'ACTIVE']
  start_date timestamptz
  end_date timestamptz
  validity_days int [not null, default: 30]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  // VoucherType: BOOKING_DISCOUNT, SWAP_DISCOUNT, FREE_MINUTES, CASHBACK
  // VoucherStatus: ACTIVE, INACTIVE, EXPIRED
}

Table voucher_redemption {
  id uuid [pk, type: 'UUID']
  user_id uuid [not null, ref: > user_account.id]
  voucher_definition_id uuid [not null, ref: > voucher_definition.id]
  voucher_code varchar(50) [unique, not null]
  status varchar(20) [not null, default: 'REDEEMED']
  points_spent int [not null]
  redeemed_at timestamptz [not null]
  used_at timestamptz
  expires_at timestamptz [not null]
  metadata jsonb
  booking_id uuid [ref: > booking.id]
  service_type varchar(20)
  // RedemptionStatus: REDEEMED, USED, EXPIRED
}

Table station_rating {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  station_id uuid [not null, ref: > station.id]
  rating int [not null]
  comment text
  eligibility_id uuid [ref: > rating_eligibility.id]
  is_verified boolean [not null, default: false]
  helpful_count int [not null, default: 0]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  // RatingStatus: ACTIVE, FLAGGED, HIDDEN
}

Table referral {
  id uuid [pk, default: 'uuid_generate_v4()']
  referrer_id uuid [not null, ref: > user_account.id]
  referee_id uuid [ref: > user_account.id]
  referral_code varchar(50) [not null]
  status varchar(20) [not null, default: 'PENDING']
  referred_at timestamptz [not null]
  // ReferralStatus: PENDING, COMPLETED, CANCELLED
  // Unique: (referrer_id, referral_code)
}

Table loyalty_badge {
  id uuid [pk, default: 'uuid_generate_v4()']
  code varchar(50) [unique, not null]
  name varchar(100) [not null]
  description text
  icon varchar(255)
  tier varchar(20) [not null]
  criteria_type varchar(20) [not null]
  criteria_value int [not null]
  points_bonus int [not null, default: 0]
  created_at timestamptz [not null]
  // BadgeTier: BRONZE, SILVER, GOLD, PLATINUM, DIAMOND
  // BadgeCriteriaType: TOTAL_BOOKINGS, TOTAL_SWAPS, TOTAL_RATINGS, etc.
}

Table user_badge {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  badge_id uuid [not null, ref: > loyalty_badge.id]
  earned_at timestamptz [not null]
  // Unique: (user_id, badge_id)
}

Table rating_eligibility {
  id uuid [pk, default: 'uuid_generate_v4()']
  user_id uuid [not null, ref: > user_account.id]
  station_id uuid [not null, ref: > station.id]
  source_type varchar(20) [not null]
  source_id uuid [not null]
  eligible_at timestamptz [not null]
  is_rated boolean [not null, default: false]
  created_at timestamptz [not null]
  // EligibilityType: BOOKING, REFERRAL
  // Unique: (user_id, station_id, source_type, source_id)
}

Table audit_log {
  id uuid [pk, default: 'uuid_generate_v4()']
  actor_id uuid [not null, ref: > user_account.id]
  actor_role varchar(50) [not null]
  action varchar(50) [not null]
  entity_type varchar(100) [not null]
  entity_id uuid
  metadata jsonb [not null, default: "'{}'"]
  created_at timestamptz [not null]
}

// ============================================================
// GROUP 9: Notifications
// ============================================================

Table ev_user_notification {
  id uuid [pk, default: 'uuid_generate_v4()']
  recipient_id uuid [not null, ref: > user_account.id]
  type varchar(20) [not null]
  category varchar(50) [not null]
  title varchar(255) [not null]
  body text [not null]
  data_json jsonb
  is_read boolean [not null, default: false]
  reference_id uuid
  reference_type varchar(50)
  created_at timestamptz [not null]
  // EvUserNotificationType: BOOKING, LOYALTY, SYSTEM, PROMOTION
}

Table collaborator_notification {
  id uuid [pk, default: 'uuid_generate_v4()']
  recipient_id uuid [not null, ref: > user_account.id]
  type varchar(20) [not null]
  category varchar(50) [not null]
  title varchar(255) [not null]
  body text [not null]
  data_json jsonb
  is_read boolean [not null, default: false]
  reference_id uuid
  reference_type varchar(50)
  created_at timestamptz [not null]
  // NotificationType: TASK, EARNING, SYSTEM, PROMOTION
}

// ============================================================
// IMPORTANT INDEXES
// ============================================================

// charger_unit
Index: charger_unit.station_id [name: 'idx_charger_unit_station_id']
Index: charger_unit.station_id, charger_unit.power_type, charger_unit.power_kw [name: 'idx_charger_unit_station_power']
Index: charger_unit.station_version_id [name: 'idx_charger_unit_station_version_id']

// booking
Index: booking.user_id, booking.status [name: 'idx_booking_user_status']
Index: booking.station_id [name: 'idx_booking_station_id']
Index: booking.status [name: 'idx_booking_status']
